  "disclaimer": "Unofficial planning workbench. Rules reflect publicly available ARC NCGP announcements verified Nov 2026. Always verify eligibility, dates, and limits against final Grant Opportunity Guidelines and RMS before submitting.",
  "pointLifecycle": {
    "pending": "Points lock on the submission/closing date and remain locked while the application is under assessment until outcome announcement.",
    "active": "For funded grants, points remain locked continuously until the official project end date.",
    "released": "Points return on the outcome announcement date if unsuccessful, or after the project end date when completed.",
    "noEarlyRelinquishmentWarning": "No early relinquishment: active ARC projects and roles cannot be relinquished early to free up Research Points."
  },
  "teachingReliefRule": "Unsalaried Chief Investigators (CI / Lead CI / Node Lead CI / Director) are eligible for up to $50,000/year in teaching relief. Teaching relief cannot be combined with an ARC-salaried role (SCI, Initiate Fellowship, or Legacy DECRA/FT) during overlapping quarters.",
  "changelog": [
    {
      "version": "2026.11.1",
      "date": "2026-11-24",
      "summary": "Verified NCGP 13-point scheme matrix and official ARC reference links (Nov 2026).",
      "changes": [
        "Confirmed Explore Q1 2027 launch (Mar 2027) with Lead CI (5), CI (3), SCI (ECR) (8) point costs and partial randomisation trial.",
        "Added full 8-scheme NCGP matrix including Initiate Fellowships, Lead & Mentor, Indigenous Excellence, Collaborate, CIEF, Breakthrough, and Prioritise.",
        "Added 0-point legacy grant tracking (DP, LP, DECRA, FT) and $50k/yr teaching relief vs. SCI salary conflict rules."
      ]
    },
    {
      "version": "2026.07.0",
      "date": "2026-07-22",
      "summary": "Initial baseline aligned with the NCGP Policy Review Final Report (July 2026).",
      "changes": [
        "Established 13 Research Points cap per investigator across NCGP schemes.",
        "Defined point lock lifecycle from submission through outcome and funded project end date."
      ]
    }
  ],
